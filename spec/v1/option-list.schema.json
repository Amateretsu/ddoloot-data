{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "option-list.schema.json",
  "title": "Shared option list (one entry of option-lists.json)",
  "type": "object",
  "required": ["id", "options"],
  "properties": {
    "id": {"$ref": "common.schema.json#/$defs/slug"},
    "kind": {"$ref": "common.schema.json#/$defs/slug"},
    "options": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/option"}}
  },
  "$defs": {
    "option": {
      "type": "object",
      "required": ["key", "name"],
      "properties": {
        "key": {"$ref": "common.schema.json#/$defs/slug"},
        "name": {"type": "string", "minLength": 1},
        "colour": {"type": ["string", "null"]},
        "level": {"type": ["integer", "null"]},
        "value": {"type": ["number", "null"]},
        "tooltip": {"type": ["string", "null"]}
      }
    }
  }
}
