{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redirect.schema.json",
  "title": "Named Item redirect (one entry of redirects.json); to=null means removed",
  "type": "object",
  "required": ["from", "to"],
  "properties": {
    "from": {"$ref": "common.schema.json#/$defs/uuid"},
    "to": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/uuid"}]}
  }
}
