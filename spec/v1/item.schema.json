{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "item.schema.json",
  "title": "Named Item (one entry of items.json)",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "wiki",
    "slots_status"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "weapon",
        "armor",
        "shield",
        "jewelry",
        "clothing",
        "other"
      ]
    },
    "item_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "introduced_update": {
      "type": [
        "string",
        "null"
      ]
    },
    "minimum_level": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "required_race": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "binding": {
      "enum": [
        "account",
        "character",
        "on_equip",
        "unbound",
        null
      ]
    },
    "material": {
      "type": [
        "string",
        "null"
      ]
    },
    "hardness": {
      "type": [
        "integer",
        "null"
      ]
    },
    "durability": {
      "type": [
        "integer",
        "null"
      ]
    },
    "base_value_cp": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "weight": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item_effect"
      },
      "default": []
    },
    "weapon_stats": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/weapon_stats"
        }
      ]
    },
    "armor_stats": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/armor_stats"
        }
      ]
    },
    "named_set": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/named_set"
        }
      ]
    },
    "source": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/source"
        }
      ]
    },
    "flavor_text": {
      "type": [
        "string",
        "null"
      ]
    },
    "wiki": {
      "type": "object",
      "required": [
        "page_id",
        "title",
        "url"
      ],
      "properties": {
        "page_id": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        },
        "revision_id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "slots_status": {
      "enum": [
        "known",
        "unknown"
      ]
    },
    "customisation_slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/customisation_slot"
      },
      "default": []
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      },
      "default": []
    },
    "equip_slots": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/slug"
      },
      "default": [],
      "description": "Every equipment slot the item can be worn in (e.g. wrists and feet)."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "slots_status": {
            "const": "unknown"
          }
        }
      },
      "then": {
        "properties": {
          "customisation_slots": {
            "maxItems": 0
          },
          "constraints": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "item_effect": {
      "type": "object",
      "required": [
        "effect"
      ],
      "properties": {
        "effect": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "bonus_type": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/slug"
            }
          ]
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "weapon_stats": {
      "type": "object",
      "properties": {
        "damage_dice": {
          "type": [
            "string",
            "null"
          ]
        },
        "damage_bonus": {
          "type": [
            "integer",
            "null"
          ]
        },
        "damage_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "critical_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "critical_multiplier": {
          "type": [
            "integer",
            "null"
          ]
        },
        "enhancement_bonus": {
          "type": [
            "integer",
            "null"
          ]
        },
        "handedness": {
          "type": [
            "string",
            "null"
          ]
        },
        "proficiency": {
          "type": [
            "string",
            "null"
          ]
        },
        "weapon_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "armor_stats": {
      "type": "object",
      "properties": {
        "armor_type": {
          "type": [
            "string",
            "null"
          ]
        },
        "armor_bonus": {
          "type": [
            "integer",
            "null"
          ]
        },
        "max_dex_bonus": {
          "type": [
            "integer",
            "null"
          ]
        },
        "armor_check_penalty": {
          "type": [
            "integer",
            "null"
          ]
        },
        "arcane_spell_failure": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    },
    "named_set": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "bonuses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pieces_required",
              "description"
            ],
            "properties": {
              "pieces_required": {
                "type": "integer",
                "minimum": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "quests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chest": {
          "type": [
            "string",
            "null"
          ]
        },
        "dropped_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "crafted_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "customisation_slot": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "min",
        "max"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "kind": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "colour": {
          "type": "string",
          "description": "Augment slot colour. With no options, valid options are the entries of the `augments` list whose colour slot-compat.colour_compat accepts for this colour."
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "options": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "shared"
              ],
              "properties": {
                "shared": {
                  "$ref": "common.schema.json#/$defs/slug"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "inline"
              ],
              "properties": {
                "inline": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "option-list.schema.json#/$defs/option"
                  }
                }
              }
            }
          ]
        }
      },
      "anyOf": [
        {
          "required": [
            "options"
          ]
        },
        {
          "required": [
            "colour"
          ]
        }
      ]
    },
    "constraint": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "mutually_exclusive",
            "max_selected",
            "min_selected",
            "requires"
          ]
        },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/slug"
          },
          "description": "Customisation slot ids (mutually_exclusive, max_selected, min_selected)."
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "if_slot": {
          "$ref": "common.schema.json#/$defs/slug",
          "description": "requires: when this slot has a selection..."
        },
        "then_slot": {
          "$ref": "common.schema.json#/$defs/slug",
          "description": "...this slot must also have one."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "requires"
              }
            }
          },
          "then": {
            "required": [
              "if_slot",
              "then_slot"
            ]
          },
          "else": {
            "required": [
              "slots"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "max_selected",
                  "min_selected"
                ]
              }
            }
          },
          "then": {
            "required": [
              "count"
            ]
          }
        }
      ]
    }
  }
}